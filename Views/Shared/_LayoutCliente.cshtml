@{
    ViewData["Title"] = "CapyBeads";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/Cliente.css" />

    <!-- Librerías necesarias -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <!-- Navbar fija en la parte superior centrada -->
    <div class="navbar">
        <div class="navbar-content">
            <div class="menu-container glass">
                <a asp-action="TodosLosProductos" asp-controller="Cliente" class="menu-item">
                    <img src="/IMG/capifigura.png" alt="Capy Purosos">
                </a>
                <a asp-action="VerCarrito" asp-controller="Cliente" class="menu-item">
                    <img src="/IMG/capicarrito.png" alt="Capy Carrito">
                </a>
                <a asp-action="IndexCliente" asp-controller="Cliente" class="menu-item-2">
                    <img src="/IMG/logo.jpg" alt="Capy Beads">
                </a>
                <a asp-action="Perfil" asp-controller="Cliente" class="menu-item-2">
                    <img src="/IMG/capiuser.png" alt="Perfil">
                </a>
                <div class="search-container">
                    <a class="dropdown-item" asp-area="" asp-controller="Login" asp-action="Index">Cerrar sesión</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenedor principal -->
    <div class="container">
        <!-- Barra Lateral de Categorías -->
        <aside class="sidebar">
            <h2>Categorías</h2>
            @if (ViewBag.Categorias != null)
            {
                <div class="categories">
                    <div class="category-item">
                        <a asp-action="TodosLosProductos" asp-route-idCategoria=""
                           class="category-filter @(ViewBag.CategoriaSeleccionada == null ? "active" : "")">
                            Todo
                        </a>
                    </div>
                    @foreach (var categoria in ViewBag.Categorias)
                    {
                        <div class="category-item">
                            <a asp-action="TodosLosProductos" asp-route-idCategoria="@categoria.id_categoria"
                               class="category-filter @(ViewBag.CategoriaSeleccionada == categoria.id_categoria ? "active" : "")">
                                @categoria.nombreCategoria
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>No hay categorías disponibles.</p>
            }
        </aside>

        <!-- Contenido principal -->
        <main>
            <div class="container-fluid px-4">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts adicionales específicos de cada vista -->
    @RenderSection("Scripts", required: false)
</body>
</html>

<style>
    /* Barra lateral */
.sidebar {
    width: 250px;
    margin-right: 20px;
    position: fixed;
    left: 25px;
    top: 100px;
    background-color: #34495e;
    padding: 20px;
    border-radius: 8px;
    color: #ecf0f1;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    font-family: Arial, sans-serif;
    overflow-y: auto;
    max-height: calc(100vh - 150px);
}

    .sidebar h2 {
        font-size: 20px;
        margin-bottom: 15px;
        color: #1abc9c;
        font-weight: bold;
        text-align: center;
    }

.categories {
    display: flex;
    flex-direction: column;
}

.category-item {
    margin-bottom: 10px;
}

    .category-item a {
        display: block;
        padding: 5px 10px;
        color: #ecf0f1;
        text-decoration: none;
        background-color: #3d566e;
        border-radius: 5px;
        list-style:none;
        transition: background-color 0.3s, color 0.3s;
        font-weight: 500;
        text-align: center;
        width: 100%;
    }

        .category-item a:hover,
        .category-item a.active {
            background-color: #1abc9c;
            color: #ffffff;
            font-weight: bold;
        }

        .category-item a.active {
            background-color: #16a085;
            color: #ffffff;
        }
</style>