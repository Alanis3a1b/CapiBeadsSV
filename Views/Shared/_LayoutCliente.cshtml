@{
    ViewData["Title"] = "_LayoutCliente";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/Cliente.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>
<body>
    <!-- Navbar fija en la parte superior -->
    <div class="navbar">
        <div class="menu-container glass">
            <a href="/pagina1" class="menu-item"><img src="/IMG/capifigura.png" alt="Capy Purosos"></a>
            <a href="/pagina2" class="menu-item"><img src="/IMG/capicarrito.png" alt="Capy Carrito"></a>
            <a href="/pagina3" class="menu-item-2"><img src="/IMG/logo.jpg" alt="Capy Beads"></a>
            <a href="/pagina4" class="menu-item"><img src="/IMG/capiuser.png" alt="Perfil"></a>
            <div class="search-container"><input type="text" placeholder="productos"><button type="submit">🔍</button></div>
        </div>
    </div>

    <!-- Contenedor principal -->
    <div class="container">
        <!-- Barra Lateral -->
        <aside class="sidebar glass">
            <h2>Categorías</h2>
            <ul class="categories">
                <li>Todo</li>
                <li>Anime</li>
                <li>Series</li>
                <li>Accesorios</li>
                <li>Animales</li>
                <li>Películas</li>
            </ul>
            <h2>Tiendas</h2>
            <ul class="stores">
                <li>Capibeads</li>
                <li>Kat Pin</li>
                <li>Duck Loot</li>
                <li>Todas</li>
            </ul>
        </aside>

        <!-- Contenido principal -->
        <main>
            <div class="container-fluid px-4">
                @RenderBody()
            </div>
        </main>
    </div>
</body>
</html>
