
@{

    ViewData["Title"] = "Usuario Categoria";
}

<head>
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/Usuario_Categoria.css" />
</head>

<div class="navbar-container">
    <div class="navbar-header">
        <div class="navbar-background"></div>
        <a href="@Url.Action("Index", "Home")">
        <img class="logo" src="~/IMG/pastocapi.jpg" alt="Logo Principal" />
         </a>
        <img class="carrito" src="~/IMG/capicarrito (1).png" alt="Carrito" />
    </div>
    <a href="@Url.Action("UsuarioCategoria", "Home")">
        <img class="figura" src="~/IMG/capifigura.png" alt="Figura" />
    </a>
    <div class="user-section">

        <img class="user-icon" src="~/IMG/capiuser.png" alt="Usuario" />

    </div>
    <div class="search-bar">
        <div class="search-background"></div>
        <div class="search-icon-background"></div>
        <img class="search-icon" src="~/IMG/lipa.png" alt="Buscar" />
        <div class="search-text">productos</div>
    </div>
</div>


<img class="Sr_Capy-img" src="~/IMG/Sr_Capy.png" alt="Imagen Rotada" />

<div class="categoria-card">
    <div class="categoria-background"></div>
    <div class="categoria-header">
        <div class="categoria-title">Categorias</div>
    </div>
    <div class="categoria-list">
        <div class="categoria-item">
            <div class="circle"></div>
            <span>Todo</span>
        </div>
        <div class="categoria-item">
            <div class="circle"></div>
            <span>Anime</span>
        </div>
        <div class="categoria-item">
            <div class="circle"></div>
            <span>Series</span>
        </div>
        <div class="categoria-item">
            <div class="circle"></div>
            <span>Accesorios</span>
        </div>
        <div class="categoria-item">
            <div class="circle"></div>
            <span>Animales</span>
        </div>
        <div class="categoria-item">
            <div class="circle"></div>
            <span>Peliculas</span>
        </div>
    </div>
</div>

<div class="tienda-card">
    <div class="tienda-background"></div>
    <div class="tienda-header">
        <div class="tienda-title">Tiendas</div>
    </div>
    <div class="tienda-list">
        <div class="tienda-item">
            <div class="circle"></div>
            <span>Capibeads</span>
        </div>
        <div class="tienda-item">
            <div class="circle"></div>
            <span>Kat pin</span>
        </div>
        <div class="tienda-item">
            <div class="circle"></div>
            <span>Duck Loot</span>
        </div>
        <div class="tienda-item">
            <div class="circle active"></div>
            <span>Todas</span>
        </div>
    </div>
</div>

    <div class="product-gallery">
        <div class="product-item">
            <img src="~/IMG/rey.webp" alt="Producto 1">
            <div class="product-info">
                <span>Rei Ayanami</span>
                <span class="price">$3.75</span>
            </div>
            <button class="add-to-cart">Agregar a la bolsa</button>
        </div>
        <div class="product-item">
            <img src="~/IMG/kirby.jpg" alt="Producto 2">
            <div class="product-info">
                <span>Kirby</span>
                <span class="price">$3.75</span>
            </div>
            <button class="add-to-cart">Agregar a la bolsa</button>
        </div>
        <div class="product-item">
            <img src="~/IMG/catv.jpg" alt="Producto 3">
            <div class="product-info">
                <span>Cat Pin</span>
                <span class="price">$3.50</span>
            </div>
            <button class="add-to-cart">Agregar a la bolsa</button>
        </div>
        <div class="product-item">
            <img src="~/IMG/litten.webp" alt="Producto 4">
            <div class="product-info">
                <span>Litten</span>
                <span class="price">$3.50</span>
            </div>
            <button class="add-to-cart">Agregar a la bolsa</button>
        </div>
        <div class="product-item">
            <img src="~/IMG/HAUNT.jpg" alt="Producto 5">
            <div class="product-info">
                <span>Haunt</span>
                <span class="price">$3.50</span>
            </div>
            <button class="add-to-cart">Agregar a la bolsa</button>
        </div>
    <div class="product-item">
        <img src="~/IMG/ajolote.jpg" alt="Producto 6">
        <div class="product-info">
            <span>ajolote</span>
            <span class="price">$3.50</span>
        </div>
        <button class="add-to-cart">Agregar a la bolsa</button>
    </div>
    <div class="product-item">
        <img src="~/IMG/snorlax.jpg" alt="Producto 7">
        <div class="product-info">
            <span>snorlax</span>
            <span class="price">$2.50</span>
        </div>
        <button class="add-to-cart">Agregar a la bolsa</button>
    </div>
    <div class="product-item">
        <img src="~/IMG/diablo.webp" alt="Producto 8">
        <div class="product-info">
            <span>Giratina</span>
            <span class="price">$3.50</span>
        </div>
        <button class="add-to-cart">Agregar a la bolsa</button>
    </div>
    <div class="product-item">
        <img src="~/IMG/dino.jpg" alt="Producto 9">
        <div class="product-info">
            <span>Jurasic park</span>
            <span class="price">$2.00</span>
        </div>
        <button class="add-to-cart">Agregar a la bolsa</button>
    </div>
    </div>
</div>

