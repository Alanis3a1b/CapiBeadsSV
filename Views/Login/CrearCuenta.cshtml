@{
    Layout = "_LoginLayout";
}
<head>
    <link rel="stylesheet" href="/css/site.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
</head>

<form asp-action="CrearrCuenta">
    <!--Lineas para capturar la informacion-->
    <div class="Fondo">
        <div class="container-fluid">
            <div class="login-container-2">
                <!-- Logo -->
                <img src="/IMG/logo.jpg" alt="CapiBeads Logo" class="img-fluid mx-auto d-block mb-3" style="width: 350px; border-radius: 8px;">

                <!-- Encabezado -->
                <h4>Registrarse</h4>

                <div class="form-group">
                    <label for="nombre_ticket" class="font-weight-bold">Ingrese el nombre del usuario: <span style="color: red;">*</span></label>
                    @Html.TextBox("nombre", "", new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label for="correo" class="font-weight-bold">Ingrese el correo del usuario: <span style="color: red;">*</span></label>
                    @Html.TextBox("correo", "", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label for="rol" class="font-weight-bold">Seleccione el tipo de usuario a crear: <span style="color: red;">*</span></label>
                    @Html.DropDownList("id_rol", ViewData["listadoDeRoles"] as SelectList, "--Sin rol--", new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label for="telefono_contacto" class="font-weight-bold">Ingrese su teléfono: <span style="color: red;">*</span></label>
                    @Html.TextBox("telefono_contacto", "", new { @class = "form-control" })
                </div>
                <hr>
                <div class="form-group" style="text-align: left;">
                    <label for="usuario" class="font-weight-bold">Ingrese el usuario con el que se autenticará (No mayor de 20 caracteres): <span style="color: red;">*</span></label>
                    @Html.TextBox("usuario", "", new { @class = "form-control" })
                </div>

                <div class="form-group">
                    <label for="contraseña" class="font-weight-bold">Ingrese la contraseña del usuario: <span style="color: red;">*</span></label>
                    @Html.TextBox("contrasenya", "", new { @class = "form-control" })
                </div>

                <div class="d-flex justify-content-end">
                    <!-- Utiliza un botón de tipo "button" para evitar envíos de formulario -->
                    <input type="submit" class="btn btn-primary btn-lg small" value="CREAR CUENTA" />
                </div>
            </div>
        </div>
    </div>


</form>
