@model IEnumerable<CapiBeadsSV.Models.categorias>

@{
    ViewData["Title"] = "Categorías";
    Layout = "_LayoutAdmin";
}

<main>
    @if (TempData["Mensaje"] != null)
    {
        <div id="mensajeTemp" class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }
    <hr>
    <div style="background-color: rgba(255, 255, 255, 0.8); color: #333; border-radius: 8px; padding: 15px; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2); margin-bottom: 20px; width: 100%; text-align: left;">
        Categorias dentro del sistema
    </div>
    <div class="container mt-5">
        <a asp-action="CreateCategoria" class="btn btn-primary mb-3">Agregar Nueva Categoría</a>

        <table class="table table-bordered text-center">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var categoria in Model)
                {
                    <tr>
                        <td>@categoria.id_categoria</td>
                        <td>@categoria.nombreCategoria</td>
                        <td>
                            <a asp-action="EditCategoria" asp-route-id="@categoria.id_categoria" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="DeleteCategoria" asp-route-id="@categoria.id_categoria" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

<script>
    setTimeout(function () {
        var mensaje = document.getElementById("mensajeTemp");
        if (mensaje) {
            mensaje.style.display = "none";
        }
    }, 5000);
</script>
