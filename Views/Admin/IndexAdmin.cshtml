@{
    Layout = "_LayoutAdmin";
    var usuarios = ViewBag.usuarios;
}

<main>
    @* Mostrar mensaje de confirmación *@
    @if (TempData["Mensaje"] != null)
    {
        <div id="mensajeTemp" class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <h2>Usuarios</h2>
    <a asp-action="CreateUsuarioAdmin" class="btn btn-primary">Agregar Usuario</a>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in usuarios)
            {
                <tr>
                    <td>@usuario.id_usuario</td>
                    <td>@usuario.nombre</td>
                    <td>@usuario.correo</td>
                    <td>@usuario.telefono_contacto</td>
                    <td>@usuario.usuario</td>
                    <td>@usuario.rol</td>
                    <td>
                        <a asp-action="EditUsuario" asp-route-id="@usuario.id_usuario" class="btn btn-warning">Editar</a>
                        <a asp-action="DeleteUsuario" asp-route-id="@usuario.id_usuario" class="btn btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</main>

<script>
    // Temporizador para ocultar el mensaje después de 5 segundos (5000 ms)
    setTimeout(function () {
        var mensaje = document.getElementById("mensajeTemp");
        if (mensaje) {
            mensaje.style.display = "none";
        }
    }, 5000); // Ajusta el tiempo (en milisegundos) según lo que necesites
</script>