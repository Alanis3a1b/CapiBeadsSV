@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Órdenes";
    Layout = "_LayoutAdmin";
}

<h1>Lista de Órdenes</h1>
<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>ID</th>
            <th>Dirección</th>
            <th>Total</th>
            <th>Fecha de Orden</th>
            <th>Estado de Pedido</th>
            <th>Cliente</th>
            <th>Productos</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var orden in Model)
        {
            <tr>
                <td>@orden.id_orden</td>
                <td>@orden.direccion</td>
                <td>@orden.total.ToString("C2")</td>
                <td>@orden.fechaOrden.ToShortDateString()</td>
                <td>@orden.EstadoPedido</td>
                <td>@orden.Cliente</td>
                <td>
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Tienda</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario</th>
                                <th>Imagen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in orden.Productos)
                            {
                                <tr>
                                    <td>@producto.Producto</td>
                                    <td>@producto.Tienda</td>
                                    <td>@producto.Cantidad</td>
                                    <td>@producto.PrecioUnitario.ToString("C2")</td>
                                    <td>
                                        @if (producto.ImagenProducto != null)
                                        {
                                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(producto.ImagenProducto)"
                                                 alt="@producto.Producto"
                                                 style="max-height: 50px; max-width: 50px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span>No disponible</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@orden.id_orden" class="btn btn-warning">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@orden.id_orden" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
