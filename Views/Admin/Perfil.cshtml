@{
    Layout = "_LayoutAdmin";
    var tiendas = ViewBag.Tiendas;
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario Ajustes</title>
    <link rel="stylesheet" href="/css/Admin.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #a2845e;
            font-family: 'Press Start 2P', cursive;
        }

        .container {
            max-width: 1440px;
            margin-top: 50px;
        }

        .card {
            background-color: rgba(162, 132, 94, 0.94);
            border-radius: 10px;
            padding: 20px;
        }

        .card-header {
            background-color: #6f42c1;
            color: white;
            text-align: center;
            font-size: 24px;
        }

        .form-label {
            font-size: 20px;
            color: white;
        }

        .form-control {
            margin-bottom: 10px;
            border: 2px solid #4CAF50;
        }

        .btn {
            font-size: 16px;
            background-color: #65558F;
            color: white;
            width: 100%;
            margin-top: 10px;
        }

        .profile-section {
            text-align: center;
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
        }

            .profile-section img {
                width: 150px;
                height: 150px;
                margin-bottom: 10px;
            }

            .profile-section strong, .profile-section p {
                font-size: 16px;
                color: black;
            }

        #tempMessage {
            transition: opacity 3s ease-out;
        }

        .custom-file-label::after {
            content: "Seleccionar Archivo";
        }
    </style>
</head>
<body>
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success" id="tempMessage">
            @TempData["Message"]
        </div>
    }

    <div class="container">
        <div class="row">
            <!-- Card Ajustes -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        AJUSTES
                    </div>

                    <!-- Formulario para cambiar foto de perfil -->
                    <form action="/Vendedor/CambiarFotoPerfil" method="post" enctype="multipart/form-data" class="mt-4">
                        <div class="mb-3">
                            <label for="profilePicture" class="form-label">Subir Nueva foto de Perfil:</label>
                            <input type="file" class="form-control" id="profilePicture" name="photoUpload" accept="image/*">
                        </div>
                        <button type="submit" class="btn">Guardar cambios</button>
                    </form>

                    <h2 style="font-family: 'Montserrat', sans-serif; color: white;">Cambiar Contraseña</h2>
                    <form asp-action="CambiarContrasena" method="post">
                        <div class="form-group">
                            <label for="currentPassword" class="form-label">Contraseña actual</label>
                            <input type="password" name="currentPassword" id="currentPassword" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label for="newPassword" class="form-label">Nueva contraseña</label>
                            <input type="password" name="newPassword" id="newPassword" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label for="confirmNewPassword" class="form-label">Confirmar la contraseña</label>
                            <input type="password" name="confirmNewPassword" id="confirmNewPassword" class="form-control" required />
                        </div>

                        <button type="submit" class="btn">Actualizar contraseña</button>
                    </form>
                </div>
            </div>
            <!-- Card Perfil de Cliente -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        PERFIL DE CLIENTE
                    </div>
                    <div class="profile-section">
                        <div class="mb-3">
                            @if (ViewBag.FotoUsuario != null)
                            {
                                <img src="@ViewBag.FotoUsuario" alt="Foto de perfil">
                            }
                            else
                            {
                                <p>No hay foto de perfil disponible.</p>
                            }
                        </div>
                        <div class="mb-3">
                            <strong>Nombre:</strong>
                            <p>@ViewBag.NombreUsuario</p>
                        </div>
                        <div class="mb-3">
                            <strong>Correo:</strong>
                            <p>@ViewBag.CorreoUsuario</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Script para ocultar el mensaje después de 3 segundos
        setTimeout(function () {
            var message = document.getElementById("tempMessage");
            if (message) {
                message.style.opacity = "0";
                setTimeout(() => message.remove(), 3000);  // Remueve el elemento completamente después de 3 segundos
            }
        }, 3000);
    </script>
</body>