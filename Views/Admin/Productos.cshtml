@{
    Layout = "_LayoutAdmin";
}
<h2>Listado de Productos</h2>
<a asp-action="CreateProducto" class="btn btn-primary">Agregar Producto</a>
<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Tienda</th>
            <th>Categoría</th>
            <th>Estado</th>
            <th>Imagen</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in ViewBag.Productos)
        {
            <tr>
                <td>@producto.nombreProducto</td>
                <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@producto.descripcion</td>
                <td>@producto.precio.ToString("C")</td>
                <td>@producto.TiendaNombre</td>
                <td>@producto.CategoriaNombre</td>
                <td>@producto.EstadoProducto</td>
                <td>
                    @if (producto.imagenProducto != null)
                    {
                        <img src="data:image;base64,@(Convert.ToBase64String(producto.imagenProducto))" width="50" height="50" alt="Imagen del producto" />
                    }
                    else
                    {
                        <span>No disponible</span>
                    }
                </td>
                <td>
                    <a class="btn btn-warning" href="@Url.Action("EditProducto", "Admin", new { id = producto.id_producto })">Editar</a>
                    <a class="btn btn-danger" href="@Url.Action("DeleteProducto", "Admin", new { id = producto.id_producto })">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
