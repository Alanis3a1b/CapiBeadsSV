@{
    ViewData["Title"] = "Producto Eliminado";
    Layout = "_LayoutAdmin";
}

<div class="container mt-5">
    <div class="card mb-3">
        <div class="card-header" style="background-color: #935E34; color: white;">
            ¡Producto Eliminado Correctamente!
        </div>
        <div class="card-body" style="background-color: #d3d3d3; color: black;">
