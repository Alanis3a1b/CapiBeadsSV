
@{
    Layout = "_LayoutAdmin";
}
<head>
    <link rel="stylesheet" href="/css/Admin.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<div class="container mt-5">
    <div class="card mb-3">
        <div class="card-header" style="background-color: #935E34; color: white;">
            GESTIONAR USUARIO
        </div>
        <div class="card-body" style="background-color: #d3d3d3; color: black;">
            <p class="font-weight-bold" style="text-align: left;">
                CREAR NUEVO USUARIO ADMINISTRADOR
            </p>
            <hr>
            <form asp-action="CreateUsuarios">
                <div class="form-group">
                    <label for="nombre_ticket" class="font-weight-bold">Ingrese el nombre del usuario: <span style="color: red;">*</span></label>
                    @Html.TextBox("nombre", "", new { @class = "form-control", required = "required", maxlength = "50", pattern = "^[A-Za-zÁÉÍÓÚáéíóúÑñ ]+$" })
                </div>

                <div class="form-group">
                    <label for="correo" class="font-weight-bold">Ingrese el correo del usuario: <span style="color: red;">*</span></label>
                    @Html.TextBox("correo", "", new { @class = "form-control", type = "email", required = "required" })
                </div>

                <div class="form-group">
                    <label for="rol" class="font-weight-bold">Seleccione el tipo de usuario a crear: <span style="color: red;">*</span></label>
                    @Html.DropDownList("id_rol", ViewData["listadoDeRoles"] as SelectList, "--Sin rol--", new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label for="telefono_contacto" class="font-weight-bold">Ingrese su teléfono: <span style="color: red;">*</span></label>
                    @Html.TextBox("telefono_contacto", "", new { @class = "form-control", type = "tel", required = "required", maxlength = "9", pattern = "\\d{4}-\\d{4}" })
                </div>

                <hr>

                <div class="form-group" style="text-align: left;">
                    <label for="usuario" class="font-weight-bold">Ingrese el usuario con el que se autenticará (No mayor de 20 caracteres): <span style="color: red;">*</span></label>
                    @Html.TextBox("usuario", "", new { @class = "form-control", required = "required", maxlength = "20", pattern = "^[A-Za-z0-9]+$" })
                </div>

                <div class="form-group">
                    <label for="contraseña" class="font-weight-bold">Ingrese la contraseña del usuario: <span style="color: red;">*</span></label>
                    @Html.TextBox("contrasenya", "", new { @class = "form-control", type = "password", required = "required", minlength = "8", maxlength = "20" })
                </div>


                <div class="d-flex justify-content-end">
                    <!-- Utiliza un botón de tipo "button" para evitar envíos de formulario -->
                    <input type="submit" class="btn btn-primary btn-lg small" value="CREAR USUARIOS" />
                </div>

            </form>        

        </div>
    </div>
</div>
<script>
    // Nombre: Solo letras y espacios
    document.getElementsByName("nombre")[0].addEventListener("input", function (e) {
        e.target.value = e.target.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ ]/g, ''); // Permite solo letras y espacios
    });

    // Teléfono: Formato 1234-5678
    document.getElementsByName("telefono_contacto")[0].addEventListener("input", function (e) {
        let input = e.target.value.replace(/\D/g, ''); // Elimina caracteres no numéricos
        if (input.length > 4) {
            input = input.slice(0, 4) + '-' + input.slice(4, 8); // Inserta el guion en el quinto lugar
        }
        e.target.value = input;
    });

    // Usuario: Solo letras y números, máximo 20 caracteres
    document.getElementsByName("usuario")[0].addEventListener("input", function (e) {
        e.target.value = e.target.value.replace(/[^A-Za-z0-9]/g, ''); // Permite solo letras y números
    });

</script>