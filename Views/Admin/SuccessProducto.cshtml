@{
    Layout = "_LayoutAdmin";
}

<div class="notification-container">
    <div class="notification-header">
        Notificación
    </div>
    <div class="notification-body">
        <span class="notification-message">Se ha agregado el producto correctamente</span><br /><br />
        <span class="notification-submessage">Continúa agregando tus productos con nosotros</span>
    </div>
    <a href="@Url.Action("Productos")" class="notification-button">Regresar</a>
    <img src="~/IMG/Sr_capibara.png" class="notification-image" alt="Imagen decorativa" />
</div>

<style>
    .notification-container {
        width: 679px;
        height: 315px;
        top: 100px;
        left: 250px;
        position: relative;
        background: white;
        box-shadow: 0px 4px 15px 5px rgba(0, 0, 0, 0.10);
    }

    .notification-header {
        width: 679px;
        height: 65px;
        padding: 18px 0 17px 25px;
        position: absolute;
        background: #107A54;
        color: white;
        font-size: 18px;
        font-family: Montserrat;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .notification-body {
        width: 488px;
        height: 81px;
        position: absolute;
        left: 192px;
        top: 124px;
        text-align: center;
        font-family: Montserrat;
        font-size: 20px;
        font-weight: 600;
    }

    .notification-message {
        color: black;
    }

    .notification-submessage {
        color: #838383;
    }

    .notification-button {
        width: 150px;
        height: 50px;
        position: absolute;
        left: 342px;
        top: 222px;
        background: #A2845E;
        color: white;
        font-size: 18px;
        font-family: Montserrat;
        font-weight: 600;
        text-align: center;
        line-height: 50px;
        border-radius: 10px;
        box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
        text-decoration: none;
        display: inline-block;
    }

    .notification-image {
        width: 211px;
        height: 210px;
        position: absolute;
        left: 20px;
        top: 83px;
    }

</style>