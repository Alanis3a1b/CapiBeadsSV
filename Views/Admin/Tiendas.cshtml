@{
    ViewData["Title"] = "Tiendas";
    Layout = "_LayoutAdmin";
}


<hr>
<div style="background-color: rgba(255, 255, 255, 0.8); color: #333; border-radius: 8px; padding: 15px; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2); margin-bottom: 20px; width: 100%; text-align: left;">
    Todas las tiendas dentro del sistema
</div>

<a href="@Url.Action("CreateTienda")" class="btn btn-primary">Crear Nueva Tienda</a>


<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre de la Tienda</th>
            <th>Descripción</th>
            <th>Propietario</th>
            <th>Imagen</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tienda in ViewBag.tiendas)
        {
            <tr>
                <td>@tienda.id_tienda</td>
                <td>@tienda.nombreTienda</td>
                <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@tienda.descripcionTienda</td>
                <td>@tienda.UsuarioNombre</td>
                <td>@tienda.imagenFondo</td>
                <td>
                    <a class="btn btn-warning" href="@Url.Action("EditTienda", new { id = tienda.id_tienda })">Editar</a> |
                    <a class="btn btn-danger" href="@Url.Action("DeleteTienda", new { id = tienda.id_tienda })">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>


