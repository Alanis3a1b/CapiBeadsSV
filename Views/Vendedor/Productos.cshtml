@{
    Layout = "_LayoutVendedor";
    var productoUsuario = ViewBag.Productos;

}

<main>
    @* Mostrar mensaje de confirmación *@
    @if (TempData["Mensaje"] != null)
    {
        <div id="mensajeTemp" class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }
    <hr>
    <div style="background-color: rgba(255, 255, 255, 0.8); color: #333; border-radius: 8px; padding: 15px; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2); margin-bottom: 20px; width: 100%; text-align: left;">
        Todos los productos
    </div>
    <a asp-action="CreateProducto" class="btn btn-primary">Agregar Producto</a> 
    <table class="table">
        <thead>
            <tr>
                <th>ID Producto</th>
                <th>Nombre</th>
                <th>Tienda</th>
                <th>Descripción</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Imagen</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in productoUsuario)
            {
                <tr>
                    <td>@producto.id_producto</td>
                    <td>@producto.nombreProducto</td>
                    <td>@producto.nombreTienda</td>
                    <td>@producto.descripcion</td>
                    <td>@producto.CategoriaNombre</td>
                        <td>@producto.precio</td>
                        <td>
                        @if (producto.imagenProducto != null)
                        {
                                <img src="data:image;base64,@(Convert.ToBase64String(producto.imagenProducto))" width="50" height="50" alt="Imagen del producto" />
                        }
                        else
                        {
                                <span>No disponible</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditProducto" asp-route-id="@producto.id_producto" class="btn btn-warning">Editar</a>
                        <a asp-action="DeleteProducto" asp-route-id="@producto.id_producto" class="btn btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
   
</main>

<script>
    // Temporizador para ocultar el mensaje después de 5 segundos (5000 ms)
    setTimeout(function () {
        var mensaje = document.getElementById("mensajeTemp");
        if (mensaje) {
            mensaje.style.display = "none";
        }
    }, 5000); // Ajusta el tiempo (en milisegundos) según lo que necesites
</script>