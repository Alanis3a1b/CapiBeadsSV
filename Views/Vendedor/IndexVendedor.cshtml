@{
    Layout = "_LayoutVendedor";
    var tiendas = ViewBag.Tiendas;
}


<div class="Fondo">
   <h2>Vendedor</h2>
    <table class="table">
        <thead>
            <tr>
                <th>ID Tienda</th>
                <th>Nombre Tienda</th>
                <th>Descripcion Tienda</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tienda in tiendas)
            {
                <tr>
                    <td>@tienda.id_tienda</td>
                    <td>@tienda.nombreTienda</td>
                    <td>@tienda.descripcionTienda</td>
                    <td>
                        <a asp-action="EditUsuario" asp-route-id="@tienda.id_tienda" class="btn btn-warning">Editar</a>
                        <a asp-action="DeleteUsuario" asp-route-id="@tienda.id_tienda" class="btn btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


