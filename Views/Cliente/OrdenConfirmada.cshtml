@model CapiBeadsSV.Models.ordenes
@{
    Layout = "_LayoutCliente";
}

<div class="orden-confirmada">
    <h2>¡Orden Confirmada!</h2>
    <p>Su orden ha sido creada exitosamente.</p>

    <div class="orden-detalles">
        <p><strong>ID de Orden:</strong> @Model.id_orden</p>
        <p><strong>Total:</strong> $@Model.total.ToString("F2")</p>
        <p><strong>Dirección de Envío:</strong> @Model.direccion</p>
        <p><strong>Fecha de Orden:</strong> @Model.fechaOrden.ToString("g")</p>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("IndexCliente", "Cliente")" class="btn btn-primary">Regresar</a>
    </div>
</div>
